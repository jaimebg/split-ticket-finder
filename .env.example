# Copy to .env and fill in. Never commit .env — it holds your bot token.

# ── Required ────────────────────────────────────────────────────────────────

# Bot token from @BotFather on Telegram.
BOT_TOKEN=

# Your numeric Telegram user id, from @userinfobot. The bot is single-user and
# rejects everyone else, so this must be set or nobody can talk to it.
OWNER_ID=


# ── Route search ────────────────────────────────────────────────────────────

# Home airport (IATA). Default LPA (Gran Canaria).
# Any airport works, but the discount only makes sense from one whose residents
# qualify: LPA TFN TFS ACE FUE SPC GMZ VDE (Canaries), PMI IBZ MAH (Balearics),
# MLN (Melilla).
ORIGIN=LPA

# Hubs whose leg from ORIGIN qualifies for the discount, comma-separated.
# Defaults to the Spanish mainland hubs; Portuguese hubs are never discounted.
# DISCOUNT_AIRPORTS=MAD,BCN,AGP,SVQ,VLC,BIO

# Fraction taken off the qualifying leg. 0.75 = you pay 25%, which is Spain's
# statutory resident discount for extra-peninsular territories.
DOMESTIC_DISCOUNT=0.75


# ── Scraper tuning ──────────────────────────────────────────────────────────

# Requests in flight at once. Raising this speeds up searches but hits Google
# harder; 4 is a deliberate compromise.
MAX_CONCURRENCY=4

# Seconds each worker waits between its own requests.
DEFAULT_DELAY=2.5

# Per-request timeout in seconds, and retries for transient failures (429/5xx).
REQUEST_TIMEOUT=20
MAX_RETRIES=2

# Google's cookie-consent cookie. Not a secret; it only suppresses the consent
# interstitial. Override if responses stop containing flight data.
# SOCS_COOKIE=


# ── Price tracking ──────────────────────────────────────────────────────────

# How often the background scheduler re-checks tracked routes.
ALERT_INTERVAL_HOURS=6

# Drop below the recorded best price needed to trigger an alert. 0.10 = 10%.
PRICE_DROP_THRESHOLD=0.10


# ── Storage ─────────────────────────────────────────────────────────────────

DB_PATH=flight_finder.db


# ── Providers ────────────────────────────────────────────
# Which flight sources to use, in preference order. Valid names: kiwi, google.
# A google-only setup works but falls back to the slower grid search, since
# Google exposes no price calendar.
PROVIDERS=kiwi,google
# Which one drives a search. Must appear in PROVIDERS.
PRIMARY_PROVIDER=kiwi

# Kiwi tolerates far more load than scraping Google does, so it has its own
# concurrency budget.
KIWI_CONCURRENCY=8
KIWI_DELAY=0.3
# Partner identifier required by the Kiwi GraphQL endpoint. Not a secret.
# An invalid value fails loudly rather than degrading quietly.
KIWI_PARTNER=skypicker


# ── Engine tuning ────────────────────────────────────────────────────────────
# The two-stage engine's own knobs. The defaults are the numbers it was
# verified against end to end (32 calendar requests -> 2,184 ranked
# candidates for free -> ~30 confirmed against real offers -> 92 requests
# total); change one only if you understand the request-cost tradeoff it buys.

# K -- how many of phase 0's ranked candidates get confirmed against real
# offers in phase 1. Higher finds more at the cost of more requests.
SHORTLIST_SIZE=30

# Diversity caps applied to that shortlist, so one unusually cheap hub or
# date can't crowd out every other option. Each must be at most
# SHORTLIST_SIZE, or it never actually caps anything.
MAX_PER_HUB=6
MAX_PER_DATE=4

# Distinct dates priced for the through-fare (single-ticket) baseline used
# to state the saving.
THROUGH_FARE_DATES=3

# Dates sampled by the grid fallback, used only for a provider with no price
# calendar (Google).
FALLBACK_MAX_DATES=12

# Upper bound on a search window, in days -- the verified limit of Kiwi's
# price-calendar endpoint.
MAX_WINDOW_DAYS=91
